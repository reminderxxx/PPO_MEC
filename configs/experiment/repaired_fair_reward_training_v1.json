{
  "version": "repaired_fair_reward_training_v1",
  "scope": "independent_development_convergence_experiment",
  "agents": [
    "sa_ghmappo",
    "ppo",
    "mappo",
    "dqn",
    "dueling_dqn",
    "qmix",
    "controller_mat",
    "dag_offload_drl",
    "cache_offload_drl",
    "dt_handoff_drl"
  ],
  "seeds": [
    7,
    13,
    29
  ],
  "max_mobility_rows": 30000,
  "window_length": 24,
