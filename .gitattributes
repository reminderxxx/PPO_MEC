* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
# G14R22 producer-integrity fixtures retain the exact CSV bytes emitted during acceptance.
artifacts/analysis/typed_model_cache_g14r22_holdout_execution_contract_20260923_v1/non_holdout_acceptance/public_entry_output/published/scientific/**/benchmark_rows.csv -text
*.tex text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.pt binary
*.pth binary
*.ckpt binary
*.onnx binary
*.tar.gz binary
*.zip binary

# Repository datasets are versioned through Git LFS.
data/** filter=lfs diff=lfs merge=lfs -text
